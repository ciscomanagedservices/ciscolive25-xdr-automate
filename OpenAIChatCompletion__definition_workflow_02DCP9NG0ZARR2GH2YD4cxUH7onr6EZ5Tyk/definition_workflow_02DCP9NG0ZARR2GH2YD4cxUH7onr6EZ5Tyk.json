                          "description": "Sets retry counter to -1 to exit the while loop after successful API call",
                          "display_name": "Exit Retry Loop (Set Retries to -1)",
                          "skip_execution": false,
                          "variables_to_update": [
                            {
                              "variable_to_update": "$workflow.definition_workflow_02DCP9NG0ZARR2GH2YD4cxUH7onr6EZ5Tyk.input.variable_workflow_02EK4JATH9EHF2PSKigI7bWK66u6IYft759$",
                              "variable_value_new": -1
                            }
                          ]
                        },
                        "object_type": "definition_activity"
                      },
                      {
                        "unique_name": "definition_activity_02DCW7FZETHQJ1IU7w4j5nl2awW6T5Uj40C",
                        "name": "Execute Python Script",
                        "title": "Extract Response Data",
                        "type": "python3.script",
                        "base_type": "activity",
                        "properties": {
                          "action_timeout": 180,
                          "continue_on_failure": false,
                          "description": "Parses OpenAI response and extracts message content, tool calls, and conversation history",
                          "display_name": "Extract Response Data",
                          "script": "\"\"\"Extract and Format OpenAI Response Data\n\nParses the API response and extracts:\n- Message content (text from assistant)\n- Tool calls (function calls requested by model)\n- Updated conversation history (optionally appending new response)\n\"\"\"\nimport json\nimport sys\n\n# Parse inputs\ni_messages = json.loads(sys.argv[1])\nresponse_body = json.loads(sys.argv[2])\nshould_append = sys.argv[3].lower() == 'true'\n\n# Extract response data\no_choices = json.dumps(response_body.get('choices', []))\nresponse_message = response_body['choices'][0]['message']\n\n# Extract message content (may be None if only tool calls)\no_message_content = response_message.get('content') or ''\n\n# Extract tool calls if present\nif 'tool_calls' in response_message and response_message['tool_calls']:\n    o_tool_calls = json.dumps(response_message['tool_calls'])\nelse:\n    o_tool_calls = '[]'\n\n# Clean response message for history\n# OpenAI API doesn't accept null values, convert to empty string\nfor key in ['tool_calls', 'function_call']:\n    if response_message.get(key) is None:\n        response_message.pop(key, None)\n\nfor key in list(response_message.keys()):\n    if response_message[key] is None:\n        response_message[key] = ''\n\n# Build conversation history\nif should_append:\n    # Append new message to existing history\n    o_messages = i_messages\n    o_messages.append(response_message)\nelse:\n    # Return only the new message\n    o_messages = [response_message]\n\no_messages = json.dumps(o_messages)",
                          "script_arguments": [
                            "$workflow.definition_workflow_02DCP9NG0ZARR2GH2YD4cxUH7onr6EZ5Tyk.input.variable_workflow_02DCPG9XUFVXL1LuTteFioSWzi1yPNRlBzp$",
                            "$activity.definition_activity_02DCPN7ZMSHE53mGIST66lLNvtvPIiH2u2f.output.response_body$",
                            "$workflow.definition_workflow_02DCP9NG0ZARR2GH2YD4cxUH7onr6EZ5Tyk.input.variable_workflow_02DCWAP5RWCYV3GWvXD2cTbSUsIB0Hwr6WW$"
                          ],
                          "script_queries": [
                            {
                              "script_query": "o_messages",
                              "script_query_name": "o_messages",
                              "script_query_type": "string"
                            },
                            {
