      "delete_workflow_instance": false,
      "description": "Executes OpenAI Chat Completion API calls with support for both OpenAI and Azure OpenAI endpoints. Handles conversation history, tool/function calling, automatic retries, and response formatting. Returns structured outputs including message content, tool calls, and updated conversation history.",
      "display_name": "OpenAI Chat Completion",
      "runtime_user": {
        "target_default": true
      },
      "target": {
        "no_target": true
      }
    },
    "object_type": "definition_workflow",
    "actions": [
      {
        "unique_name": "definition_activity_02DCVSTR1ZEIQ2Uqo6eOKKodTJi4eaQJG5h",
        "name": "Execute Python Script",
        "title": "Build API Request Body and Path",
        "type": "python3.script",
        "base_type": "activity",
        "properties": {
          "action_timeout": 180,
          "continue_on_failure": false,
          "description": "Constructs the HTTP request body and URL path for OpenAI API. Handles differences between OpenAI and Azure OpenAI formats. Includes workaround for known multi_tool_use.parallel issue.",
          "display_name": "Build API Request Body and Path",
          "script": "\"\"\"Build OpenAI Chat Completion API Request\n\nConstructs request body and URL path for OpenAI or Azure OpenAI API.\nHandles platform-specific differences and applies necessary workarounds.\n\nWorkarounds Applied:\n- multi_tool_use.parallel -> parallel (fixes GitHub issue microsoft/semantic-kernel#4447)\n\"\"\"\nimport sys\nimport json\n\n# Parse inputs\nmodel_id = sys.argv[1]\napi_version = sys.argv[2]\nis_azure = sys.argv[3].lower() == 'true'\ntemperature = float(sys.argv[4])\ntools = json.loads(sys.argv[5])\nresponse_format = json.loads(sys.argv[6])\nmessages = json.loads(sys.argv[7])\n\n# Build request based on platform\nif is_azure:\n    # Azure OpenAI uses deployment name in path and requires api-version\n    completions_path = f'/openai/deployments/{model_id}/chat/completions?api-version={api_version}'\n    body = {\n        \"temperature\": temperature,\n        \"stream\": False,\n        \"tools\": tools,\n        \"response_format\": response_format,\n        \"messages\": messages\n    }\nelse:\n    # Standard OpenAI API\n    completions_path = '/v1/chat/completions'\n    body = {\n        \"model\": model_id,\n        \"temperature\": temperature,\n        \"stream\": False,\n        \"tools\": tools,\n        \"response_format\": response_format,\n        \"messages\": messages\n    }\n\n# Remove empty tools array (API doesn't accept empty tools)\nif not body.get('tools'):\n    body.pop('tools', None)\n\n# Apply workaround for multi_tool_use.parallel issue\n# See: https://github.com/microsoft/semantic-kernel/issues/4447\njson_body = json.dumps(body)\njson_body = json_body.replace('multi_tool_use.parallel', 'parallel')\n\n# Output results\ncompletions_path = completions_path\njson_body = json_body",
          "script_arguments": [
            "$workflow.definition_workflow_02DCP9NG0ZARR2GH2YD4cxUH7onr6EZ5Tyk.input.variable_workflow_02DCPFF9V1FW04KATEfsyPF6ieCB6arYreD$",
            "$workflow.definition_workflow_02DCP9NG0ZARR2GH2YD4cxUH7onr6EZ5Tyk.input.variable_workflow_02IEXCLNKZUJI6kajAKTbDJRu8TytdmrEsz$",
            "$workflow.definition_workflow_02DCP9NG0ZARR2GH2YD4cxUH7onr6EZ5Tyk.input.variable_workflow_02IEXBSZFSRB14jR70ReVz2WzBtJxmSbkxi$",
            "$workflow.definition_workflow_02DCP9NG0ZARR2GH2YD4cxUH7onr6EZ5Tyk.input.variable_workflow_02DCPGTLVZGAS7aR4bIIOVtW8NIun8YbFmR$",
            "$workflow.definition_workflow_02DCP9NG0ZARR2GH2YD4cxUH7onr6EZ5Tyk.input.variable_workflow_02DCPKDU1XY3B2TGa0NL8Pv0Q5A8tkVXdKF$",
            "$workflow.definition_workflow_02DCP9NG0ZARR2GH2YD4cxUH7onr6EZ5Tyk.input.variable_workflow_02DCPLMRWZQT71EMCd4SD9wzijc97Pw3NlN$",
            "$workflow.definition_workflow_02DCP9NG0ZARR2GH2YD4cxUH7onr6EZ5Tyk.input.variable_workflow_02DCPG9XUFVXL1LuTteFioSWzi1yPNRlBzp$"
          ],
